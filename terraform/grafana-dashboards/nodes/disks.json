    {
      "type": "stat",
      "title": "NVMe composite temp",
      "description": "Drive-reported composite temperature (what the NVMe's own warning/critical thresholds use). Alerts: NvmeTemperatureHigh >= 78\u00b0C, NvmeTemperatureCritical >= 83\u00b0C.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 9,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "orange",
                "value": 78
              },
              {
                "color": "red",
                "value": 83
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (nodename) (node_hwmon_temp_celsius{chip=~\"nvme.*\", sensor=\"temp1\"} * on(job, instance) group_left(nodename) node_uname_info{job=~\"$job\", nodename=~\"$nodename\"})",
          "legendFormat": "{{nodename}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "bargauge",
      "title": "Fullest filesystem per node",
      "description": "",
