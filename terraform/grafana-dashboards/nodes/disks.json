          "editorMode": "code",
          "expr": "count(node_filesystem_readonly{fstype!~\"tmpfs|ramfs|overlay|squashfs|nsfs|fuse.*|devtmpfs|efivarfs\", mountpoint!~\"/run.*|/var/lib/kubelet.*|/var/lib/containerd.*|/boot/efi\"} * on(job, instance) group_left(nodename) node_uname_info{job=~\"$job\", nodename=~\"$nodename\"} == 1) or vector(0)",
          "legendFormat": "read-only",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
