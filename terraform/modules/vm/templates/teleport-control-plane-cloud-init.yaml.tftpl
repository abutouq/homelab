#cloud-config
users:
  - name: ${username}
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}

package_update: true

packages:
  - certbot
  - python3-certbot-dns-cloudflare

write_files:
  - path: /etc/letsencrypt/cloudflare.ini
    owner: root:root
    permissions: '0600'
    content: |
      dns_cloudflare_api_token = ${cloudflare_api_token}

  - path: /etc/teleport.yaml
    owner: root:root
    permissions: '0600'
    content: |
      version: v3
      teleport:
        nodename: ${nodename}
        auth_server: 127.0.0.1:3025
        data_dir: /var/lib/teleport
        join_params:
          token_name: ""
          method: token
        log:
          output: stderr
          severity: INFO
          format:
            output: json
        diag_addr: ""
        ca_pin: ""
      auth_service:
        enabled: "yes"
        listen_addr: 0.0.0.0:3025
        cluster_name: ${cluster_name}
        proxy_listener_mode: multiplex
      ssh_service:
        enabled: "yes"
      proxy_service:
        enabled: "yes"
        web_listen_addr: 0.0.0.0:443
        public_addr: ${cluster_name}:443
        https_keypairs:
          - key_file: /etc/letsencrypt/live/${cluster_name}/privkey.pem
            cert_file: /etc/letsencrypt/live/${cluster_name}/fullchain.pem
        # Teleport re-reads the keypair on this interval, so certbot renewals
        # are picked up without a restart or a deploy hook.
        https_keypairs_reload_interval: 1h
      app_service:
        enabled: "no"

runcmd:
  - mkdir -p /etc/apt/keyrings
  - curl -fsSL https://apt.releases.teleport.dev/gpg -o /etc/apt/keyrings/teleport-archive-keyring.asc
  - echo "deb [signed-by=/etc/apt/keyrings/teleport-archive-keyring.asc] https://apt.releases.teleport.dev/ubuntu noble stable/v18" > /etc/apt/sources.list.d/teleport.list
  - apt-get update -qq
  - apt-get install -y teleport
  # The cert must exist before Teleport starts, or the proxy fails to load its keypair.
  - certbot certonly --non-interactive --agree-tos --register-unsafely-without-email --dns-cloudflare --dns-cloudflare-credentials /etc/letsencrypt/cloudflare.ini --dns-cloudflare-propagation-seconds 30 --cert-name ${cluster_name} -d ${cluster_name} -d '*.${cluster_name}' %{ if acme_staging }--staging%{ endif }
  - systemctl enable --now certbot.timer
  - systemctl enable teleport
  - systemctl restart teleport
