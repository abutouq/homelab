#cloud-config
# Staged outside /etc/vault.d: the vault package owns that dir and its default
# vault.hcl, and the vault user doesn't exist until the package is installed.
write_files:
  - path: /etc/letsencrypt/cloudflare.ini
    owner: root:root
    permissions: '0600'
    content: |
      dns_cloudflare_api_token = ${cloudflare_api_token}

  - path: /root/vault-bootstrap/vault.hcl
    owner: root:root
    permissions: '0600'
    content: |
      ui = true

      # Recommended with integrated storage (raft mmaps its data files); the
      # cloud image has no swap, so secrets still never hit disk.
      disable_mlock = true

      storage "raft" {
        path    = "/opt/vault/data"
        node_id = "${nodename}"
      }

      listener "tcp" {
        address         = "0.0.0.0:443"
        cluster_address = "0.0.0.0:8201"
        tls_cert_file   = "/opt/vault/tls/fullchain.pem"
        tls_key_file    = "/opt/vault/tls/privkey.pem"
      }

      api_addr     = "https://${vault_domain}"
      cluster_addr = "https://${vault_ip}:8201"

runcmd:
  - install -o vault -g vault -m 0640 /root/vault-bootstrap/vault.hcl /etc/vault.d/vault.hcl
  - certbot certonly --non-interactive --agree-tos --register-unsafely-without-email --dns-cloudflare --dns-cloudflare-credentials /etc/letsencrypt/cloudflare.ini --dns-cloudflare-propagation-seconds 30 --cert-name ${vault_domain} -d ${vault_domain} %{ if acme_staging }--staging%{ endif }
  # certbot only runs renewal-hooks/deploy on renew, so run it once for the first cert
  - RENEWED_LINEAGE=/etc/letsencrypt/live/${vault_domain} /etc/letsencrypt/renewal-hooks/deploy/vault.sh
  - systemctl enable --now certbot.timer
  - systemctl enable --now vault
  # Deliberately NOT automated: `vault operator init`. It generates the unseal
  # keys and root token, which belong in a password manager, not on this disk.
