#cloud-config
# Routed OpenVPN server (packages baked by packer/openvpn.pkr.hcl). The PKI and
# tls-crypt key come from Terraform, so a rebuilt VM keeps the same CA and the
# client profiles in Vault (secret/apps/openvpn-clients) keep working.
# Keys are read as root before openvpn drops to nobody, so root-only is enough.

write_files:
  - path: /etc/openvpn/server/ca.crt
    owner: root:root
    permissions: '0644'
    encoding: b64
    content: ${openvpn_ca_cert_b64}
  - path: /etc/openvpn/server/server.crt
    owner: root:root
    permissions: '0644'
    encoding: b64
    content: ${openvpn_server_cert_b64}
  - path: /etc/openvpn/server/server.key
    owner: root:root
    permissions: '0600'
    encoding: b64
    content: ${openvpn_server_key_b64}
  - path: /etc/openvpn/server/tls-crypt.key
    owner: root:root
    permissions: '0600'
    encoding: b64
    content: ${openvpn_tls_crypt_b64}

%{ if length(openvpn_totp_secrets) > 0 ~}
  # 2FA. The verify script runs after openvpn drops to nobody:nogroup, hence the group.
%{ for name, secret in openvpn_totp_secrets ~}
  - path: /etc/openvpn/server/totp/${name}
    owner: root:nogroup
    permissions: '0640'
    content: ${secret}
%{ endfor ~}
  - path: /etc/openvpn/server/verify-totp.sh
    owner: root:root
    permissions: '0755'
    content: |
      #!/bin/sh
      # auth-user-pass-verify via-file: $1 holds the username and password lines,
      # and OpenVPN sets $common_name from the (already verified) client cert.
      # Pass only if the username is the cert's name and the password is that
      # client's current TOTP code (one 30 s step of clock skew either way).
      user=$(sed -n 1p "$1")
      code=$(sed -n 2p "$1")
      [ "$user" = "$common_name" ] || exit 1
      case "$code" in [0-9][0-9][0-9][0-9][0-9][0-9]) ;; *) exit 1 ;; esac
      secret_file="/etc/openvpn/server/totp/$common_name"
      [ -r "$secret_file" ] || exit 1
      exec oathtool --totp --base32 --window 1 "$(cat "$secret_file")" "$code" >/dev/null
%{ endif ~}

  # Relative paths resolve against /etc/openvpn/server (openvpn-server@'s WorkingDirectory).
  - path: /etc/openvpn/server/server.conf
    owner: root:root
    permissions: '0644'
    content: |
      port ${openvpn_port}
      proto udp
      dev tun
      topology subnet
      server ${openvpn_server}
      ca ca.crt
      cert server.crt
      key server.key
      # ECDSA certs: ECDH only, no DH params.
      dh none
      tls-crypt tls-crypt.key
      tls-version-min 1.2
      data-ciphers AES-256-GCM:CHACHA20-POLY1305
      remote-cert-tls client
%{ if length(openvpn_totp_secrets) > 0 ~}
      # 2FA: the cert plus a TOTP code as the password (verify-totp.sh).
      script-security 2
      auth-user-pass-verify /etc/openvpn/server/verify-totp.sh via-file
      # After the first login, renegotiations (hourly) and reconnects present a
      # server-issued token instead of asking for a fresh code.
      auth-gen-token
%{ endif ~}
%{ for r in openvpn_push_routes ~}
      push "route ${r}"
%{ endfor ~}
%{ for d in openvpn_dns_servers ~}
      push "dhcp-option DNS ${d}"
%{ endfor ~}
      keepalive 10 60
      user nobody
      group nogroup
      persist-key
      persist-tun
      explicit-exit-notify 1
      verb 3

  # Clients leave the VM with its LAN address, so LAN hosts (and the router)
  # need no route back to the VPN subnet.
  - path: /etc/systemd/system/openvpn-nat.service
    owner: root:root
    permissions: '0644'
    content: |
      [Unit]
      Description=NAT for OpenVPN clients (${openvpn_network})
      Before=openvpn-server@server.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/sbin/iptables -w -t nat -A POSTROUTING -s ${openvpn_network} ! -o tun+ -j MASQUERADE
      ExecStop=/usr/sbin/iptables -w -t nat -D POSTROUTING -s ${openvpn_network} ! -o tun+ -j MASQUERADE

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl daemon-reload
  - systemctl enable --now openvpn-nat.service openvpn-server@server.service
