#cloud-config
# Monitoring VM: Grafana + Prometheus + Loki are installed (disabled) by
# packer/grafana.pkr.hcl; everything below configures and starts them.
write_files:
  # --- Prometheus (loopback only; Grafana on this VM is the consumer) ---------
  - path: /etc/prometheus/prometheus.yml
    owner: root:root
    permissions: '0644'
    content: |
      global:
        scrape_interval: 30s
        evaluation_interval: 30s
      scrape_configs:
        - job_name: prometheus
          static_configs:
            - targets: ['127.0.0.1:9090']
        - job_name: loki
          static_configs:
            - targets: ['127.0.0.1:3100']
        - job_name: grafana
          static_configs:
            - targets: ['127.0.0.1:3000']
%{ if length(node_targets) > 0 ~}
        # Hosts running node-exporter directly (Proxmox nodes: hwmon temps etc.)
        - job_name: proxmox-hosts
          static_configs:
            - targets: [${join(", ", formatlist("'%s'", node_targets))}]
%{ endif ~}
%{ if k8s_api_server != "" ~}
        # --- K8s cluster, all through the API server proxy (this VM has no
        # route to pod IPs). Identity: monitoring/prometheus-external.
        - job_name: node-exporter
          scheme: https
          authorization: {credentials_file: /etc/prometheus/k8s-token}
          tls_config: {ca_file: /etc/prometheus/k8s-ca.crt}
          kubernetes_sd_configs:
            - role: pod
              api_server: https://${k8s_api_server}
              authorization: {credentials_file: /etc/prometheus/k8s-token}
              tls_config: {ca_file: /etc/prometheus/k8s-ca.crt}
              namespaces: {names: [monitoring]}
          relabel_configs:
            - source_labels: [__meta_kubernetes_pod_label_app_kubernetes_io_name]
              regex: prometheus-node-exporter
              action: keep
            - source_labels: [__meta_kubernetes_pod_name]
              target_label: __metrics_path__
              replacement: /api/v1/namespaces/monitoring/pods/$1:9100/proxy/metrics
            # host:port, as the node dashboards' $node:$port variables expect
            - source_labels: [__meta_kubernetes_pod_host_ip]
              target_label: instance
              replacement: $1:9100
            - source_labels: [__meta_kubernetes_pod_node_name]
              target_label: node
            - target_label: __address__
              replacement: ${k8s_api_server}
        - job_name: kubelet
          scheme: https
          authorization: {credentials_file: /etc/prometheus/k8s-token}
          tls_config: {ca_file: /etc/prometheus/k8s-ca.crt}
          kubernetes_sd_configs:
            - role: node
              api_server: https://${k8s_api_server}
              authorization: {credentials_file: /etc/prometheus/k8s-token}
              tls_config: {ca_file: /etc/prometheus/k8s-ca.crt}
          relabel_configs:
            - source_labels: [__meta_kubernetes_node_name]
              target_label: __metrics_path__
              replacement: /api/v1/nodes/$1/proxy/metrics
            - source_labels: [__meta_kubernetes_node_name]
              target_label: instance
            - target_label: __address__
              replacement: ${k8s_api_server}
        - job_name: cadvisor
          scheme: https
          authorization: {credentials_file: /etc/prometheus/k8s-token}
          tls_config: {ca_file: /etc/prometheus/k8s-ca.crt}
          kubernetes_sd_configs:
            - role: node
              api_server: https://${k8s_api_server}
              authorization: {credentials_file: /etc/prometheus/k8s-token}
              tls_config: {ca_file: /etc/prometheus/k8s-ca.crt}
          relabel_configs:
            - source_labels: [__meta_kubernetes_node_name]
              target_label: __metrics_path__
              replacement: /api/v1/nodes/$1/proxy/metrics/cadvisor
            - source_labels: [__meta_kubernetes_node_name]
              target_label: instance
            - target_label: __address__
              replacement: ${k8s_api_server}
        - job_name: kube-state-metrics
          scheme: https
          authorization: {credentials_file: /etc/prometheus/k8s-token}
          tls_config: {ca_file: /etc/prometheus/k8s-ca.crt}
          metrics_path: /api/v1/namespaces/monitoring/services/kube-state-metrics:8080/proxy/metrics
          honor_labels: true
          static_configs:
            - targets: ['${k8s_api_server}']
        - job_name: apiserver
          scheme: https
          authorization: {credentials_file: /etc/prometheus/k8s-token}
          tls_config: {ca_file: /etc/prometheus/k8s-ca.crt}
          static_configs:
            - targets: ['${k8s_api_server}']

  - path: /etc/prometheus/k8s-token
    owner: root:prometheus
    permissions: '0640'
    content: ${k8s_token}
  - path: /etc/prometheus/k8s-ca.crt
    owner: root:prometheus
    permissions: '0644'
    encoding: b64
    content: ${base64encode(k8s_ca_crt)}
%{ endif ~}

  # --- Loki (single binary, filesystem storage, 30d retention) ----------------
  - path: /etc/loki/config.yml
    owner: root:root
    permissions: '0644'
    content: |
      auth_enabled: false
      server:
        http_listen_address: 127.0.0.1
        http_listen_port: 3100
        grpc_listen_address: 127.0.0.1
        grpc_listen_port: 9096
      common:
        instance_addr: 127.0.0.1
        path_prefix: /var/lib/loki
        storage:
          filesystem:
            chunks_directory: /var/lib/loki/chunks
            rules_directory: /var/lib/loki/rules
        replication_factor: 1
        ring:
          kvstore:
            store: inmemory
      schema_config:
        configs:
          - from: 2024-01-01
            store: tsdb
            object_store: filesystem
            schema: v13
            index:
              prefix: index_
              period: 24h
      limits_config:
        retention_period: 720h
      compactor:
        working_directory: /var/lib/loki/compactor
        retention_enabled: true
        delete_request_store: filesystem
      analytics:
        reporting_enabled: false

  # --- Grafana ----------------------------------------------------------------
  # Admin password from Vault (secret/apps/grafana). Grafana only applies it
  # when it first creates its database, which on a fresh VM is this boot.
  - path: /etc/grafana/admin.env
    owner: root:root
    permissions: '0600'
    content: |
      GF_SECURITY_ADMIN_USER=admin
      GF_SECURITY_ADMIN_PASSWORD=${grafana_admin_password}
  # root_url = the Teleport app URL users browse to. Grafana's CSRF check does
  # NOT trust that host just because it's root_url: it must be listed in
  # csrf_trusted_origins too, or browser logins fail with "origin not allowed".
  # The VM's own LAN address is trusted as well, for direct access.
  - path: /etc/systemd/system/grafana-server.service.d/homelab.conf
    owner: root:root
    permissions: '0644'
    content: |
      [Service]
      EnvironmentFile=/etc/grafana/admin.env
      Environment=GF_SERVER_ROOT_URL=${grafana_root_url}
      Environment="GF_SECURITY_CSRF_TRUSTED_ORIGINS=${grafana_public_host} ${vm_ip}:3000"

  - path: /etc/grafana/provisioning/datasources/homelab.yaml
    owner: root:root
    permissions: '0644'
    content: |
      apiVersion: 1
      datasources:
        - name: Prometheus
          uid: prometheus
          type: prometheus
          access: proxy
          url: http://127.0.0.1:9090
          isDefault: true
        - name: Loki
          uid: loki
          type: loki
          access: proxy
          url: http://127.0.0.1:3100

  - path: /etc/grafana/provisioning/dashboards/homelab.yaml
    owner: root:root
    permissions: '0644'
    content: |
      apiVersion: 1
      providers:
        - name: homelab
          type: file
          allowUiUpdates: false
          options:
            path: /var/lib/grafana/dashboards
            foldersFromFilesStructure: true

  # Dashboards from terraform/grafana-dashboards/, base64 so their $${...}
  # template variables pass through Terraform untouched.
%{ for path, b64 in grafana_dashboards ~}
  - path: /var/lib/grafana/dashboards/${path}
    owner: root:root
    permissions: '0644'
    encoding: b64
    content: ${b64}
%{ endfor ~}

runcmd:
  - install -d -o loki /var/lib/loki
  - install -d /var/lib/grafana/dashboards
  - chown -R grafana:grafana /var/lib/grafana/dashboards
  - systemctl daemon-reload
  - systemctl enable --now prometheus loki grafana-server
