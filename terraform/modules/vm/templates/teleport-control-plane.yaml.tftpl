#cloud-config
write_files:
  - path: /etc/letsencrypt/cloudflare.ini
    owner: root:root
    permissions: '0600'
    content: |
      dns_cloudflare_api_token = ${cloudflare_api_token}

  - path: /etc/teleport.yaml
    owner: root:root
    permissions: '0600'
    content: |
      version: v3
      teleport:
        nodename: ${nodename}
        auth_server: 127.0.0.1:3025
        data_dir: /var/lib/teleport
        log:
          output: stderr
          severity: INFO
          format:
            output: json
      auth_service:
        enabled: "yes"
        listen_addr: 0.0.0.0:3025
        cluster_name: ${cluster_name}
        proxy_listener_mode: multiplex
        # Static join token shared with every Terraform-created agent, so VMs
        # can join at first boot with no manual `tctl tokens add`. Static tokens
        # never expire, so it's limited to node/app joins -- it can't log in.
        tokens:
          - "node,app:${teleport_join_token}"
      ssh_service:
        enabled: "yes"
      proxy_service:
        enabled: "yes"
        web_listen_addr: 0.0.0.0:443
        public_addr: ${cluster_name}:443
        https_keypairs:
          - key_file: /etc/letsencrypt/live/${cluster_name}/privkey.pem
            cert_file: /etc/letsencrypt/live/${cluster_name}/fullchain.pem
        # Re-read hourly, so certbot renewals need no restart or deploy hook.
        https_keypairs_reload_interval: 1h
      app_service:
        enabled: "no"

runcmd:
  # The cert must exist before Teleport starts, or the proxy fails to load its keypair.
  - certbot certonly --non-interactive --agree-tos --register-unsafely-without-email --dns-cloudflare --dns-cloudflare-credentials /etc/letsencrypt/cloudflare.ini --dns-cloudflare-propagation-seconds 30 --cert-name ${cluster_name} -d ${cluster_name} -d '*.${cluster_name}' %{ if acme_staging }--staging%{ endif }
  - systemctl enable --now certbot.timer
  - systemctl enable teleport
  - systemctl restart teleport
