#cloud-config
# Samba file share of the data disk (scsi1, mounted at /srv/share). One user,
# reachable only from hosts_allow (the LAN; VPN clients arrive NATed from
# tf-openvpn-01's LAN address). With nfs_clients, /srv/share/k8s is also
# exported over NFS for Kubernetes volumes (csi-driver-nfs, one subdirectory
# per PV) and hidden from the Samba share.
manage_etc_hosts: true

packages:
  # template 9400 enables the agent; without it Terraform waits ~15 min per refresh
  - qemu-guest-agent
  - samba
%{ if length(nas_nfs_clients) > 0 ~}
  - nfs-kernel-server
%{ endif ~}

write_files:
  - path: /etc/samba/smb.conf
    owner: root:root
    permissions: '0644'
    content: |
      [global]
        server role = standalone server
        workgroup = WORKGROUP
        map to guest = never
        server min protocol = SMB2_10
        hosts allow = ${join(" ", nas_hosts_allow)} 127.0.0.1
        hosts deny = 0.0.0.0/0
        # macOS Finder/Time Machine metadata
        vfs objects = fruit streams_xattr
        fruit:metadata = stream

      [${nas_share}]
        path = /srv/share
        valid users = ${nas_user}
        read only = no
        create mask = 0664
        directory mask = 2775
%{ if length(nas_nfs_clients) > 0 ~}
        # Kubernetes volumes (NFS): not for browsing or editing over SMB
        veto files = /k8s/
%{ endif ~}
  - path: /root/nas-password
    owner: root:root
    permissions: '0600'
    content: ${nas_password}
%{ if length(nas_nfs_clients) > 0 ~}
  # no_root_squash: the CSI driver creates and chowns each PV's directory as root.
  - path: /etc/exports
    owner: root:root
    permissions: '0644'
    content: |
      /srv/share/k8s ${join(" ", [for c in nas_nfs_clients : "${c}(rw,sync,no_subtree_check,no_root_squash)"])}
%{ endif ~}
  - path: /root/nas-setup.sh
    owner: root:root
    permissions: '0700'
    content: |
      #!/bin/bash
      set -euo pipefail
      disk=/dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi1
      udevadm settle
      blkid "$disk" >/dev/null || mkfs.ext4 -L nas-data "$disk"
      mkdir -p /srv/share
      grep -q 'LABEL=nas-data' /etc/fstab || echo 'LABEL=nas-data /srv/share ext4 defaults,discard,nofail 0 2' >> /etc/fstab
      mountpoint -q /srv/share || mount /srv/share

      id ${nas_user} >/dev/null 2>&1 || useradd -M -s /usr/sbin/nologin ${nas_user}
      chown ${nas_user}:${nas_user} /srv/share
      chmod 2775 /srv/share
      pw=$(cat /root/nas-password)
      printf '%s\n%s\n' "$pw" "$pw" | smbpasswd -s -a ${nas_user}
      systemctl restart smbd
%{ if length(nas_nfs_clients) > 0 ~}

      mkdir -p /srv/share/k8s
      chown root:root /srv/share/k8s
      chmod 0755 /srv/share/k8s
      exportfs -ra
      systemctl enable --now nfs-server
%{ endif ~}

runcmd:
  - systemctl start qemu-guest-agent
  - /root/nas-setup.sh
